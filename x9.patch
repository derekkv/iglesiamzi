+++ /dev/null
@@ -1,520 +0,0 @@
--- ============================================================================
--- MÓDULO: WhatsApp / Email  (name: comunicaciones)
--- Ejecutar en Supabase SQL Editor
---
--- Reemplaza la integración de WhatsApp Web (Baileys) por la API oficial
--- WhatsApp Cloud API (Meta) y añade registro completo de correo electrónico
--- (enviados y recibidos vía IMAP).
---
--- Orden de creación respetado por dependencias de FK:
---   wa_config → wa_tags → wa_contacts → wa_templates → wa_campaigns
---   → wa_messages → wa_campaign_recipients → wa_quick_replies
---   → wa_webhook_events → email_config → email_templates
---   → email_messages → email_attachments
---
--- NOTA: la tabla legacy `whatsapp_messages` se deja intacta (está vacía) pero
--- queda deprecada: el historial nuevo vive en `wa_messages`.
--- ============================================================================
-
-
--- ============================================================================
--- 1. wa_config — credenciales de WhatsApp Cloud API (fila única, id = 1)
--- ============================================================================
-CREATE TABLE IF NOT EXISTS wa_config (
-  id                    INTEGER PRIMARY KEY DEFAULT 1 CHECK (id = 1),
-  -- Credenciales de Meta
-  phone_number_id       TEXT,
-  waba_id               TEXT,
-  business_id           TEXT,
-  access_token          TEXT,
-  app_secret            TEXT,
-  verify_token          TEXT,
-  api_version           TEXT DEFAULT 'v21.0',
-  -- Datos del número (se refrescan en el health check)
-  display_phone         TEXT,
-  verified_name         TEXT,
-  quality_rating        TEXT,
-  messaging_limit       TEXT,
-  token_expires_at      TIMESTAMPTZ,
-  -- Estado
-  is_active             BOOLEAN DEFAULT FALSE,
-  last_health_check_at  TIMESTAMPTZ,
-  last_health_ok        BOOLEAN,
-  last_health_error     TEXT,
-  -- Comportamiento
-  auto_create_contacts  BOOLEAN DEFAULT TRUE,
-  bulk_delay_ms         INTEGER DEFAULT 250,
-  updated_by            UUID REFERENCES users(id) ON DELETE SET NULL,
-  updated_at            TIMESTAMPTZ DEFAULT NOW(),
-  created_at            TIMESTAMPTZ DEFAULT NOW()
-);
-
-INSERT INTO wa_config (id) VALUES (1) ON CONFLICT (id) DO NOTHING;
-
-
--- ============================================================================
--- 2. wa_tags — etiquetas del CRM
--- ============================================================================
-CREATE TABLE IF NOT EXISTS wa_tags (
-  id          UUID PRIMARY KEY DEFAULT gen_random_uuid(),
-  nombre      TEXT NOT NULL UNIQUE,
-  color       TEXT DEFAULT '#2563eb',
-  descripcion TEXT,
-  created_by  UUID REFERENCES users(id) ON DELETE SET NULL,
-  created_at  TIMESTAMPTZ DEFAULT NOW()
-);
-
-
--- ============================================================================
--- 3. wa_contacts — núcleo del CRM
--- ============================================================================
-CREATE TABLE IF NOT EXISTS wa_contacts (
-  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),
-  wa_id            TEXT NOT NULL UNIQUE,          -- 593980932062 (sin +)
-  display_name     TEXT,                          -- nombre editable por el agente
-  profile_name     TEXT,                          -- nombre del perfil de WhatsApp
-  -- Vínculos con el sistema
-  user_id          UUID REFERENCES users(id) ON DELETE SET NULL,
-  censo_id         INTEGER,                        -- censo.id o censo_mdg.id (soft link)
-  censo_fuente     TEXT CHECK (censo_fuente IN ('protocolo', 'mdg', 'jovenes', 'ninos')),
-  ministerio       TEXT,
-  -- CRM
-  tags             TEXT[] DEFAULT '{}',
-  assigned_to      UUID REFERENCES users(id) ON DELETE SET NULL,
-  notes            TEXT,
-  -- Consentimiento y estado
-  opt_in           BOOLEAN DEFAULT TRUE,
-  opt_out_at       TIMESTAMPTZ,
-  blocked          BOOLEAN DEFAULT FALSE,
-  -- Ventana de servicio de 24 h (clave para poder enviar texto libre)
-  last_inbound_at  TIMESTAMPTZ,
-  last_outbound_at TIMESTAMPTZ,
-  window_expires_at TIMESTAMPTZ,
-  unread_count     INTEGER DEFAULT 0,
-  last_message_at  TIMESTAMPTZ,
-  last_message_preview TEXT,
-  created_at       TIMESTAMPTZ DEFAULT NOW(),
-  updated_at       TIMESTAMPTZ DEFAULT NOW()
-);
-
-CREATE INDEX IF NOT EXISTS idx_wa_contacts_wa_id ON wa_contacts(wa_id);
-CREATE INDEX IF NOT EXISTS idx_wa_contacts_user_id ON wa_contacts(user_id);
-CREATE INDEX IF NOT EXISTS idx_wa_contacts_last_message_at ON wa_contacts(last_message_at DESC);
-CREATE INDEX IF NOT EXISTS idx_wa_contacts_assigned_to ON wa_contacts(assigned_to);
-CREATE INDEX IF NOT EXISTS idx_wa_contacts_tags ON wa_contacts USING GIN(tags);
-
-
--- ============================================================================
--- 4. wa_templates — espejo de las plantillas aprobadas en Meta
---    `use_case` conecta cada plantilla con un caso de uso del sistema
--- ============================================================================
-CREATE TABLE IF NOT EXISTS wa_templates (
-  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
-  meta_id         TEXT,
-  name            TEXT NOT NULL,
-  language        TEXT NOT NULL DEFAULT 'es',
-  category        TEXT,                            -- UTILITY | MARKETING | AUTHENTICATION
-  status          TEXT DEFAULT 'PENDING',          -- APPROVED | PENDING | REJECTED | DISABLED
-  components      JSONB,                           -- definición cruda de Meta
-  body_preview    TEXT,
-  header_format   TEXT,                            -- NONE | TEXT | IMAGE | VIDEO | DOCUMENT
-  variable_count  INTEGER DEFAULT 0,
-  -- Mapeo a los emisores del sistema
-  use_case        TEXT UNIQUE,                     -- asignacion_servicio | recordatorio_5dias | ...
-  variable_map    JSONB,                           -- { "1": "userName", "2": "asignacion", ... }
-  rejected_reason TEXT,
-  quality_score   TEXT,
-  synced_at       TIMESTAMPTZ,
-  created_at      TIMESTAMPTZ DEFAULT NOW(),
-  UNIQUE (name, language)
-);
-
-CREATE INDEX IF NOT EXISTS idx_wa_templates_name ON wa_templates(name);
-CREATE INDEX IF NOT EXISTS idx_wa_templates_use_case ON wa_templates(use_case);
-
-
--- ============================================================================
--- 5. wa_campaigns — envíos masivos (WhatsApp y Email) con seguimiento
--- ============================================================================
-CREATE TABLE IF NOT EXISTS wa_campaigns (
-  id                UUID PRIMARY KEY DEFAULT gen_random_uuid(),
-  nombre            TEXT NOT NULL,
-  canal             TEXT NOT NULL DEFAULT 'whatsapp' CHECK (canal IN ('whatsapp', 'email')),
-  tipo              TEXT NOT NULL DEFAULT 'texto' CHECK (tipo IN ('texto', 'plantilla', 'media')),
-  -- Contenido
-  template_name     TEXT,
-  template_language TEXT,
-  template_params   JSONB,
-  body              TEXT,
-  asunto            TEXT,                          -- solo email
-  media_url         TEXT,
-  media_mime        TEXT,
-  media_filename    TEXT,
-  -- Métricas
-  total             INTEGER DEFAULT 0,
-  enviados          INTEGER DEFAULT 0,
-  entregados        INTEGER DEFAULT 0,
-  leidos            INTEGER DEFAULT 0,
-  fallidos          INTEGER DEFAULT 0,
-  estado            TEXT NOT NULL DEFAULT 'borrador'
-                      CHECK (estado IN ('borrador', 'enviando', 'pausada', 'completada', 'cancelada')),
-  filtro            JSONB,                         -- criterio de selección de destinatarios
-  created_by        UUID REFERENCES users(id) ON DELETE SET NULL,
-  created_by_name   TEXT,
-  started_at        TIMESTAMPTZ,
-  finished_at       TIMESTAMPTZ,
-  created_at        TIMESTAMPTZ DEFAULT NOW()
-);
