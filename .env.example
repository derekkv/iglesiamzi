# =============================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
# =============================================================================
#  Copia este archivo como `.env.local` (desarrollo) o `.env` (producción) y
#  reemplaza cada valor. NUNCA subas el archivo real con secretos a Git.
#
#  Reglas de seguridad:
#   - Las variables con prefijo NEXT_PUBLIC_ se incrustan en el navegador:
#     SOLO datos públicos, jamás secretos.
#   - SUPABASE_SERVICE_KEY, JWT_SECRET, *_PASS, *_SECRET y VAPID_PRIVATE_KEY
#     son secretos de servidor: nunca los expongas ni les pongas NEXT_PUBLIC_.
#   - Usa valores largos y aleatorios para todos los secretos en producción.
# =============================================================================


# -----------------------------------------------------------------------------
#  1) SUPABASE (base de datos)
# -----------------------------------------------------------------------------
# URL de tu proyecto Supabase (o instancia self-hosted). Ej: https://xxxx.supabase.co
SUPABASE_URL=
# Clave service_role de Supabase (SECRETO, solo servidor). Da acceso total a la BD.
SUPABASE_SERVICE_KEY=

# Mismos datos, pero para el navegador (cliente público / Realtime).
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon (pública) de Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
#  2) SESIONES Y URL PÚBLICA
# -----------------------------------------------------------------------------
# Secreto para firmar los JWT de sesión. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# URL pública del sistema (sin barra final). Ej: https://panel.tuiglesia.com
NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
#  3) APIS INTERNAS Y TAREAS PROGRAMADAS (CRON)
# -----------------------------------------------------------------------------
# Secreto para autenticar llamadas internas (ej. sincronización de correo).
# Se envía en la cabecera X-Internal-Secret.
INTERNAL_API_SECRET=
# Secreto para proteger los endpoints de cron (recordatorios, cumpleaños).
CRON_SECRET=


# -----------------------------------------------------------------------------
#  4) WEB PUSH (notificaciones del navegador)
# -----------------------------------------------------------------------------
# Genera el par de claves VAPID con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Misma clave pública, visible en el navegador para suscribir al push.
# Debe coincidir con VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# -----------------------------------------------------------------------------
#  5) CORREO SALIENTE (SMTP)  — respaldo de la config guardada en la BD
# -----------------------------------------------------------------------------
# La app usa primero la configuración de la tabla email_config; estas variables
# actúan como respaldo si esa fila no existe.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=


# -----------------------------------------------------------------------------
#  6) CORREO ENTRANTE (IMAP)  — respaldo de la config guardada en la BD
# -----------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=


# -----------------------------------------------------------------------------
#  7) WHATSAPP
# -----------------------------------------------------------------------------
# URL del microservicio de WhatsApp (si usas el servidor Baileys en worker/).
# Para la API oficial de Meta (Cloud API) la mayor parte de la config vive en la
# tabla wa_config; el token del webhook puede definirse aquí.
WA_SERVER_URL=http://localhost:3100
# Token de verificación del webhook de WhatsApp Cloud API (lo defines en Meta).
CLOUD_WHATSAPP_WEBHOOK_SECRET=


# =============================================================================
#  8) MARCA / IDENTIDAD DE LA IGLESIA  (personalización sin tocar código)
# =============================================================================
#  Estas variables las lee lib/branding.ts. Si las dejas vacías, se usan los
#  valores por defecto de la instalación original. Defínelas para personalizar
#  el sistema para tu iglesia. Todas son públicas (NEXT_PUBLIC_).
# -----------------------------------------------------------------------------
# Nombre completo. Ej: "Iglesia Nuevo Amanecer"
NEXT_PUBLIC_CHURCH_NAME=
# Nombre corto / comercial. Ej: "Nuevo Amanecer"
NEXT_PUBLIC_CHURCH_SHORT_NAME=
# Siglas o acrónimo. Ej: "INA"
NEXT_PUBLIC_CHURCH_INITIALS=
# Título de la pestaña del navegador / app. Ej: "Nuevo Amanecer"
NEXT_PUBLIC_CHURCH_APP_TITLE=
# Descripción corta (PWA / metadatos).
NEXT_PUBLIC_CHURCH_APP_DESCRIPTION=Sistema administrativo para la iglesia
# Ruta del logo dentro de /public. Reemplaza el archivo o cambia la ruta.
NEXT_PUBLIC_CHURCH_LOGO_URL=/logo.png
# Íconos de la PWA (dentro de /public).
NEXT_PUBLIC_CHURCH_ICON_192=/icon-192.png
NEXT_PUBLIC_CHURCH_ICON_512=/icon-512.png
# Color principal de la marca (hex). Se usa en la PWA.
NEXT_PUBLIC_CHURCH_THEME_COLOR=#2563eb
# Dominio público (sin https). Ej: "panel.tuiglesia.com"
NEXT_PUBLIC_CHURCH_DOMAIN=
# Correo de contacto/remitente por defecto. Ej: "notificaciones@tuiglesia.com"
NEXT_PUBLIC_CHURCH_CONTACT_EMAIL=
# Emojis de la firma en mensajes. Ej: "❤️🙏"
NEXT_PUBLIC_CHURCH_SIGNATURE_EMOJIS=❤️🙏
